<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>LogicTest</AssemblyName>
    <RootNamespace>CbtKiosk</RootNamespace>
    <!-- Reuse the app's core (cross-platform) sources verbatim. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/CbtKiosk/Hash.cs" />
    <Compile Include="../../src/CbtKiosk/Logger.cs" />
    <Compile Include="../../src/CbtKiosk/AppSettings.cs" />
    <Compile Include="../../src/CbtKiosk/KioskClient.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
